+++ b/scripts/pilot_quality_gate.py
@@ -0,0 +1,329 @@
+"""V2.98: private, source-bound, human-observed 3-presenter face pilot.
+
+This helper does not call an AI model, publish a video, certify identity,
+or decide whether Hindi mouth motion is natural. It only independently
+rechecks signed originals + saved real MP4 and helps a human record an
+explicit, revocable-by-new-review opinion on one clip for EACH speaker.
+"""
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import json
+import os
+import re
+from pathlib import Path
+
+from podcast.motion_qc import sha256_file
+from scripts.cast_five_second_cpu import source_ten_minute_gate
+from scripts.full_neural_chunks import _output_root, verify_chunks
+from scripts.neural_chunk_batch import _checksum, read_only_progress
+from scripts.real_hindi_neural_hybrid import preflight_episode
+from scripts.review_verified_neural_chunks import _page
+
+CAST = ("aarav", "meera", "kabir")
+IDS = re.compile(r"^[0-9]{3}-[0-9]{3}$")
+SHA = re.compile(r"^[0-9a-f]{64}$")
+PHRASE = "I INSPECTED ALL THREE ORIGINAL HINDI FACE CLIPS"
+STATUS = "private_human_observation_of_three_original_hindi_face_pilot_only"
+PAGE_PREFIX = "original-hindi-three-presenter-pilot-"
+REVIEW_PREFIX = "pilot-original-hindi-human-observations-"
+
+
+def plan_three_face_review(evidence: dict, output: Path, *,
+                           source_verifier=None, progress_reader=None) -> dict:
+    """Read-only SHA, original-PCM, portrait, and every saved MP4 decode gate."""
+    root = _output_root(evidence, output)
+    manifest = (source_verifier or verify_chunks)(evidence, root)
+    progress = (progress_reader or read_only_progress)(evidence, root)
+    rows = manifest.get("chunks") if isinstance(manifest, dict) else None
+    done = progress.get("_confirmed") if isinstance(progress, dict) else None
+    pending = progress.get("_pending") if isinstance(progress, dict) else None
+    lines = evidence.get("project", {}).get("lines")
+    if (not isinstance(rows, list) or len(rows) < 45
+            or not isinstance(lines, list) or len(lines) != 45
+            or not isinstance(done, dict) or not isinstance(pending, list)
+            or len(set(line["id"] for line in lines)) != 45
+            or progress.get("source_only_no_new_inference_called") is not True
+            or progress.get("human_lipsync_approved") is not False
+            or progress.get("full_ten_minute_neural_lip_sync_verified") is not False
+            or type(progress.get("original_chunks_total")) is not int
+            or progress["original_chunks_total"] != len(rows)
+            or type(progress.get("independently_decoded_previews")) is not int
+            or progress["independently_decoded_previews"] != len(done)
+            or type(progress.get("remaining_unrendered_chunks")) is not int
+            or progress["remaining_unrendered_chunks"] != len(pending)):
+        raise ValueError("Complete signed 45-turn original and independent preview scan required.")
+    original_binding = _checksum({
+        "source": manifest["source_mp4_sha256"],
+        "project": manifest["project_sha256"],
+        "portraits": manifest["portrait_sha256"],
+        "srt": manifest["original_srt_sha256"],
+        "wav": manifest["original_wav_sha256"],
+        "chunk_sha256": {r["chunk_id"]: r["chunk_wav_sha256"] for r in rows},
+    })
+    if progress.get("source_binding_sha256") != original_binding:
+        raise ValueError("Genuine saved preview inventory is not tied to current original Hindi source.")
+    seen = [r["chunk_id"] for r in rows]
+    if (len(set(seen)) != len(seen)
+            or any(not IDS.fullmatch(cid) for cid in seen)
+            or set(seen) != set(done) | set(pending)
+            or set(done) & set(pending)
+            or pending != [cid for cid in seen if cid not in done]):
+        raise ValueError("Original PCM chunk order and decoded saved preview inventory mismatch.")
+    by_id = {line["id"]: line for line in lines}
+    chosen = {}
+    for row in rows:
+        speaker = row["speaker"]
+        if speaker not in CAST or speaker != by_id[row["line_id"]]["speaker"]:
+            raise ValueError("Unexpected presenter in original Hindi manifest.")
+        cid = row["chunk_id"]
+        if speaker in chosen or cid not in done:
+            continue
+        expected_sha = done[cid]
+        path = root / "neural-one" / (cid + ".mp4")
+        if (not isinstance(expected_sha, str) or not SHA.fullmatch(expected_sha)
+                or path.is_symlink() or not path.is_file()
+                or sha256_file(path) != expected_sha):
+            raise ValueError("Saved real pilot MP4 was changed after source-bound decoder scan.")
+        seconds = row.get("duration_seconds")
+        if (isinstance(seconds, bool) or not isinstance(seconds, (int, float))
+                or not 1 <= seconds <= 10):
+            raise ValueError("Original pilot PCM duration invalid.")
+        text = by_id[row["line_id"]].get("text")
+        if not isinstance(text, str) or not text.strip():
+            raise ValueError("Source-bound original Hindi dialogue text missing.")
+        chosen[speaker] = {
+            "speaker": speaker, "id": cid, "line_id": row["line_id"],
+            "part": row["part"], "duration_seconds": seconds,
+            "original_whole_turn_text": text,
+            "preview_sha256": expected_sha,
+        }
+    if set(chosen) != set(CAST):
+        raise ValueError("A REAL independently verified face MP4 is required for EACH of Aarav, Meera and Kabir.")
+    selected = [chosen[speaker] for speaker in CAST]
+    pilot_binding = _checksum({
+        "original_binding": original_binding,
+        "selected_clip_sha256": {x["speaker"]: [x["id"], x["preview_sha256"]]
+                                 for x in selected},
+    })
+    return {
+        "schema_version": 1,
+        "status": STATUS,
+        "source_binding_sha256": original_binding,
+        "pilot_sample_binding_sha256": pilot_binding,
+        "selected": selected,
+        "three_real_original_hindi_presenters_reverified": True,
+        "new_model_inference_calls": 0,
+        "human_lipsync_approved": False,
+        "final_full_hindi_podcast_audited": False,
+        "publication_approved": False,
+    }
+
+
+def _private_page_path(root: Path, plan: dict) -> Path:
+    return root / (PAGE_PREFIX + plan["pilot_sample_binding_sha256"][:16] + ".html")
+
+
+def _expected_private_html(plan: dict) -> str:
+    """Reuse the already-tested v2.96 HTML, CSP and local-only JS."""
+    report = {
+        "preview_entries": plan["selected"],
+        "source_binding_sha256": plan["source_binding_sha256"],
+        "verified_real_speaking_face_previews": 3,
+        "original_signed_speech_chunks": 3,
+        "remaining_unrendered_original_speech_chunks": 0,
+    }
+    return _page(report).replace(
+        "Verified samples: 3 /\n3. Remaining: 0.",
+        "Three verified presenter samples. Final whole-episode review STILL REQUIRED.")
+
+
+def _assert_unchanged_local_html(path: Path, plan: dict) -> None:
+    if (path.is_symlink() or not path.is_file()
+            or path.stat().st_size > 100_000
+            or path.read_text(encoding="utf8") != _expected_private_html(plan)):
+        raise ValueError("Private three-presenter HTML altered or missing; do not trust or reuse it.")
+
+
+def prepare_manual_pilot_viewer(evidence: dict, root: Path, *,
+                                source_verifier=None, progress_reader=None) -> tuple[dict, Path]:
+    """Create or safely reopen exactly matching 3-clip OFFLINE HTML."""
+    root = _output_root(evidence, root)
+    plan = plan_three_face_review(evidence, root,
+                                  source_verifier=source_verifier,
+                                  progress_reader=progress_reader)
+    page = _private_page_path(root, plan)
+    if page.is_symlink():
+        raise ValueError("Symlinked pilot review HTML refused.")
+    if page.exists():
+        _assert_unchanged_local_html(page, plan)
+    else:
+        with page.open("x", encoding="utf8") as handle:
+            handle.write(_expected_private_html(plan))
+            handle.flush()
+            os.fsync(handle.fileno())
+    return plan, page
+
+
+def _review_name(root: Path, plan: dict) -> Path:
+    prefix = REVIEW_PREFIX + plan["pilot_sample_binding_sha256"][:16]
+    for n in range(1, 1000):
+        path = root / (prefix + f"-{n:03d}.json")
+        if path.is_symlink():
+            raise ValueError("Symlinked private manual review record refused.")
+        if not path.exists():
+            return path
+    raise ValueError("Too many private manual reviews for the same pilot media.")
+
+
+def save_human_observation(evidence: dict, output: Path,
+                           original_plan: dict, decisions: dict,
+                           acknowledgment: str, *,
+                           source_verifier=None, progress_reader=None) -> tuple[dict, Path]:
+    """Never infer approval from hashes. Human must explicitly inspect all 3."""
+    root = _output_root(evidence, output)
+    if acknowledgment != PHRASE:
+        raise ValueError("An explicit manual three-face observation acknowledgment is required.")
+    if (not isinstance(decisions, dict) or set(decisions) != set(CAST)
+            or any(type(x) is not str or x not in ("PASS", "FAIL")
+                   for x in decisions.values())):
+        raise ValueError("Exactly 3 explicit PASS/FAIL human observations are required.")
+    latest = plan_three_face_review(evidence, root,
+                                     source_verifier=source_verifier,
+                                     progress_reader=progress_reader)
+    if latest != original_plan:
+        raise ValueError("Original media or saved pilot previews changed during human review.")
+    viewer = _private_page_path(root, latest)
+    _assert_unchanged_local_html(viewer, latest)
+    content = {
+        "schema_version": 1, "status": STATUS,
+        "source_binding_sha256": latest["source_binding_sha256"],
+        "pilot_sample_binding_sha256": latest["pilot_sample_binding_sha256"],
+        "reviewed_presenters": [{
+            "speaker": item["speaker"], "chunk_id": item["id"],
+            "preview_sha256": item["preview_sha256"],
+            "human_observation": decisions[item["speaker"]],
+        } for item in latest["selected"]],
+        "reviewer_explicitly_confirmed_three_clips_inspected": True,
+        "human_self_attested_pilot_quality_pass": all(x == "PASS" for x in decisions.values()),
+        "automated_lipsync_quality_certification": False,
+        "full_ten_minute_neural_video_completed": False,
+        "full_45_turn_human_lipsync_approved": False,
+        "portrait_rights_independently_verified": False,
+        "publication_approved": False,
+        "record_created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
+    }
+    destination = _review_name(root, latest)
+    with destination.open("x", encoding="utf8") as handle:
+        json.dump(content, handle, indent=2, ensure_ascii=False, allow_nan=False)
+        handle.write("\n")
+        handle.flush()
+        os.fsync(handle.fileno())
+    return content, destination
+
+
+def inspect_latest_observation(evidence: dict, output: Path, *,
+                               source_verifier=None, progress_reader=None) -> dict:
+    """READ ONLY: compare latest self-attested note with CURRENT clip SHA."""
+    root = _output_root(evidence, output)
+    plan = plan_three_face_review(evidence, root,
+                                  source_verifier=source_verifier,
+                                  progress_reader=progress_reader)
+    prefix = REVIEW_PREFIX + plan["pilot_sample_binding_sha256"][:16]
+    notes = sorted(root.glob(prefix + "-*.json"))
+    if any(not re.fullmatch(re.escape(prefix) + r"-[0-9]{3}\.json", p.name)
+           for p in notes):
+        raise ValueError("Unexpected private pilot review note name; inspect manually.")
+    if not notes:
+        return {"saved_manual_review_exists": False,
+                "three_presenter_current_samples_verified": True,
+                "human_self_attested_pilot_quality_pass": False}
+    latest = notes[-1]
+    if (latest.is_symlink() or not latest.is_file() or latest.stat().st_size > 20_000):
+        raise ValueError("Unsafe private pilot review record.")
+    data = json.loads(latest.read_text(encoding="utf8"))
+    expected = [
+        {"speaker": r["speaker"], "chunk_id": r["id"],
+         "preview_sha256": r["preview_sha256"]}
+        for r in plan["selected"]
+    ]
+    actual = data.get("reviewed_presenters") if isinstance(data, dict) else None
+    if (not isinstance(data, dict) or data.get("status") != STATUS
+            or data.get("schema_version") != 1
+            or data.get("source_binding_sha256") != plan["source_binding_sha256"]
+            or data.get("pilot_sample_binding_sha256") != plan["pilot_sample_binding_sha256"]
+            or not isinstance(actual, list) or len(actual) != 3
+            or [{key: row.get(key) for key in expected[0]} for row in actual] != expected
+            or any(row.get("human_observation") not in ("PASS", "FAIL") for row in actual)
+            or data.get("reviewer_explicitly_confirmed_three_clips_inspected") is not True
+            or data.get("human_self_attested_pilot_quality_pass") is not all(
+                row["human_observation"] == "PASS" for row in actual)
+            or data.get("publication_approved") is not False
+            or data.get("automated_lipsync_quality_certification") is not False
+            or data.get("full_45_turn_human_lipsync_approved") is not False):
+        raise ValueError("Saved manual review differs from CURRENT source/face sample SHA or has invalid flags.")
+    return {
+        "saved_manual_review_exists": True,
+        "three_presenter_current_samples_verified": True,
+        "human_self_attested_pilot_quality_pass": data["human_self_attested_pilot_quality_pass"],
+        "manual_observations": {r["speaker"]: r["human_observation"] for r in actual},
+        "source_binding_still_matches": True,
+        "publication_approved": False,
+        "full_45_turn_human_lipsync_approved": False,
+        "review_file_name": latest.name,
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description="OFFLINE creator-observed Hindi 3-face pilot; NO models")
+    parser.add_argument("--episode-root", required=True, type=Path)
+    parser.add_argument("--portrait-dir", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--prepare", action="store_true")
+    mode.add_argument("--record", action="store_true")
+    mode.add_argument("--inspect", action="store_true")
+    parser.add_argument("--open-browser", action="store_true")
+    args = parser.parse_args(argv)
+    try:
+        evidence = preflight_episode(args.episode_root, args.portrait_dir)
+        source_ten_minute_gate(evidence)
+        if args.inspect:
+            print(json.dumps(inspect_latest_observation(evidence, args.output), indent=2))
+            return 0
+        if args.prepare:
+            plan, page = prepare_manual_pilot_viewer(evidence, args.output)
+            print("PRIVATE OFFLINE three-presenter pilot HTML:", page)
+            print("New real model calls: 0. Three saved real samples structurally verified.")
+            if args.open_browser and os.name == "nt":
+                try:
+                    os.startfile(str(page))
+                except OSError:
+                    print("Browser did not auto-open. Open private HTML manually.")
+            return 0
+        plan, page = prepare_manual_pilot_viewer(evidence, args.output)
+        print("Inspect all THREE original Hindi face clips in", page)
+        decisions = {}
+        for entry in plan["selected"]:
+            name = entry["speaker"]
+            print(name, entry["id"], "— original speech seconds:", entry["duration_seconds"])
+            print("Judge visible Hindi mouth alignment, frozen frames, cropping, identity and audio.")
+            decisions[name] = input("Type PASS or FAIL for " + name + ": ").strip()
+        print("A saved PASS is YOUR opinion only, not AI accuracy or licensing evidence.")
+        acknowledgement = input("Type EXACTLY " + PHRASE + " : ").strip()
+        report, file = save_human_observation(evidence, args.output, plan, decisions,
+                                               acknowledgement)
+        print("PRIVATE MANUAL OBSERVATION SAVED:", file)
+        print("All 3 passed by human self-report:", report["human_self_attested_pilot_quality_pass"])
+        print("FULL 10-MINUTE VIDEO / PUBLICATION APPROVAL: FALSE")
+        return 0
+    except (ValueError, KeyError, TypeError, OSError, RuntimeError, EOFError,
+            json.JSONDecodeError):
+        print("BLOCKED: source, three real face clips, private review page or explicit answers invalid."
+              " No original voices, face MP4s or existing review records intentionally changed.")
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
