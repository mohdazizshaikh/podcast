+def test_missing_kabir_real_preview_blocks_all_gate_writes(private_fake_pilot):
+    evidence, root, _, progress = private_fake_pilot
+    progress["_confirmed"].pop("003-001")
+    progress["_pending"].insert(0, "003-001")
+    progress["remaining_unrendered_chunks"] += 1
+    progress["independently_decoded_previews"] -= 1
+    with pytest.raises(ValueError, match="EACH"):
+        gate.prepare_manual_pilot_viewer(evidence, root)
+    assert not list(root.glob("*.html"))
