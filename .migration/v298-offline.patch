+def test_command_line_prepare_record_inspect_no_ai_or_publication(
+        private_fake_pilot, monkeypatch, capsys):
+    evidence, root, _, _ = private_fake_pilot
+    monkeypatch.setattr(gate, "preflight_episode", lambda *args: evidence)
+    monkeypatch.setattr(gate, "source_ten_minute_gate", lambda evidence: None)
+    params = ["--episode-root", str(root / "original"),
+              "--portrait-dir", str(root / "portraits"),
+              "--output", str(root)]
+    assert gate.main(params + ["--prepare"]) == 0
+    answers = iter(["PASS", "FAIL", "PASS", gate.PHRASE])
+    monkeypatch.setattr("builtins.input", lambda prompt: next(answers))
+    assert gate.main(params + ["--record"]) == 0
+    assert gate.main(params + ["--inspect"]) == 0
+    output = capsys.readouterr().out
+    assert '"meera": "FAIL"' in output
+    assert '"publication_approved": false' in output
+    assert "FULL 10-MINUTE VIDEO / PUBLICATION APPROVAL: FALSE" in output
+
