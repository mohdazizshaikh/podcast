+"""v2.98 offline manual 3-presenter observation. All video/voice fixtures FAKE.
+
+Only source-bound behavior is tested; these tests do not verify actual
+Hindi phonemes, human identities, legal permissions or real model inference.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from scripts import pilot_quality_gate as gate
+
+
+def _sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+@pytest.fixture
+def private_fake_pilot(tmp_path, monkeypatch):
+    root = tmp_path / "private signed Hindi PCM folder"
+    previews = root / "neural-one"
+    previews.mkdir(parents=True)
+    cast = ("aarav", "meera", "kabir")
+    lines = [
+        {"id": f"{n:03d}", "speaker": cast[(n-1) % 3],
+         "text": f"नमस्ते original Hindi speech {n}"}
+        for n in range(1, 46)
+    ]
+    rows = [
+        {"chunk_id": f"{line['id']}-001", "line_id": line["id"],
+         "speaker": line["speaker"], "part": 1,
+         "duration_seconds": 5.0, "chunk_wav_sha256": _sha(line["id"].encode())}
+        for line in lines
+    ]
+    manifest = {
+        "source_mp4_sha256": "a" * 64,
+        "project_sha256": "b" * 64,
+        "portrait_sha256": {s: "c" * 64 for s in cast},
+        "original_srt_sha256": "d" * 64,
+        "original_wav_sha256": {line["id"]: "e" * 64 for line in lines},
+        "chunks": rows,
+    }
+    for cid in ("001-001", "002-001", "003-001"):
+        (previews / (cid + ".mp4")).write_bytes(
+            b"FAKE UNIT TEST NOT A REAL FACE OR HINDI AUDIO " + cid.encode())
+    done = {cid: _sha((previews / (cid + ".mp4")).read_bytes())
+            for cid in ("001-001", "002-001", "003-001")}
+    binding = gate._checksum({
+        "source": manifest["source_mp4_sha256"],
+        "project": manifest["project_sha256"],
+        "portraits": manifest["portrait_sha256"],
+        "srt": manifest["original_srt_sha256"],
+        "wav": manifest["original_wav_sha256"],
+        "chunk_sha256": {r["chunk_id"]: r["chunk_wav_sha256"] for r in rows},
+    })
+    progress = {
+        "_confirmed": done, "_pending": [r["chunk_id"] for r in rows if r["chunk_id"] not in done],
+        "source_binding_sha256": binding, "source_only_no_new_inference_called": True,
+        "human_lipsync_approved": False,
+        "full_ten_minute_neural_lip_sync_verified": False,
+        "original_chunks_total": 45, "independently_decoded_previews": 3,
+        "remaining_unrendered_chunks": 42,
+    }
+    evidence = {"project": {"lines": lines}, "portrait_dir": tmp_path / "portraits"}
+    monkeypatch.setattr(gate, "_output_root", lambda e, out: Path(out))
+    monkeypatch.setattr(gate, "verify_chunks", lambda e, out: manifest)
+    monkeypatch.setattr(gate, "read_only_progress", lambda e, out: progress)
+    return evidence, root, manifest, progress
+
+
+def test_planner_reads_only_original_three_presenters(private_fake_pilot):
+    evidence, root, source, progress = private_fake_pilot
+    old = {p: p.read_bytes() for p in root.rglob("*") if p.is_file()}
+    plan = gate.plan_three_face_review(evidence, root)
+    assert [x["speaker"] for x in plan["selected"]] == list(gate.CAST)
+    assert [x["id"] for x in plan["selected"]] == ["001-001", "002-001", "003-001"]
+    assert plan["human_lipsync_approved"] is False
+    assert plan["publication_approved"] is False
+    assert plan["new_model_inference_calls"] == 0
+    assert {p: p.read_bytes() for p in old} == old
+
+
+def test_three_original_immutable_offline_html_and_safe_reopen(private_fake_pilot):
+    evidence, root, source, progress = private_fake_pilot
+    plan, page = gate.prepare_manual_pilot_viewer(evidence, root)
+    text = page.read_text(encoding="utf8")
+    assert "neural-one/001-001.mp4" in text
+    assert "neural-one/002-001.mp4" in text
+    assert "neural-one/003-001.mp4" in text
+    assert "connect-src 'none'" in text
+    assert "default-src 'none'" in text
+    assert "नमस्ते" in text
+    assert "https://" not in text
+    assert page.parent == root
+    assert plan["status"] == gate.STATUS
+    plan2, page2 = gate.prepare_manual_pilot_viewer(evidence, root)
+    assert plan2 == plan and page2 == page
+    page.write_text(text.replace("default-src 'none'", "default-src *"), encoding="utf8")
+    with pytest.raises(ValueError, match="altered"):
+        gate.prepare_manual_pilot_viewer(evidence, root)
+
+
+def test_no_human_pilot_pass_without_exact_three_decisions_and_phrase(private_fake_pilot):
+    evidence, root, _, _ = private_fake_pilot
+    plan, page = gate.prepare_manual_pilot_viewer(evidence, root)
+    for bad_answers in ({"aarav": "PASS"},
+                        {"aarav": "PASS", "meera": "PASS", "kabir": "YES"},
+                        {"aarav": True, "meera": "PASS", "kabir": "PASS"}):
+        with pytest.raises(ValueError):
+            gate.save_human_observation(evidence, root, plan, bad_answers, gate.PHRASE)
+    with pytest.raises(ValueError, match="acknowledgment"):
+        gate.save_human_observation(evidence, root, plan, dict.fromkeys(gate.CAST, "PASS"), "YES")
+    assert not list(root.glob("pilot-original-hindi-human-observations-*.json"))
+
+
+def test_fail_then_explicit_new_pass_creates_separate_private_reviews(private_fake_pilot):
+    evidence, root, _, _ = private_fake_pilot
+    plan, page = gate.prepare_manual_pilot_viewer(evidence, root)
+    first, first_path = gate.save_human_observation(
+        evidence, root, plan,
+        {"aarav": "PASS", "meera": "FAIL", "kabir": "PASS"}, gate.PHRASE)
+    assert first["human_self_attested_pilot_quality_pass"] is False
+    assert first["publication_approved"] is False
+    prior = first_path.read_bytes()
+    second, second_path = gate.save_human_observation(
+        evidence, root, plan, dict.fromkeys(gate.CAST, "PASS"), gate.PHRASE)
+    assert first_path != second_path
+    assert first_path.read_bytes() == prior
+    assert second["human_self_attested_pilot_quality_pass"] is True
+    assert second["full_45_turn_human_lipsync_approved"] is False
+    assert second["publication_approved"] is False
+    check = gate.inspect_latest_observation(evidence, root)
+    assert check["human_self_attested_pilot_quality_pass"] is True
+    assert check["manual_observations"] == dict.fromkeys(gate.CAST, "PASS")
+    assert check["full_45_turn_human_lipsync_approved"] is False
+
