+def test_changed_real_preview_sha_blocks_record_after_human_inspection(private_fake_pilot):
+    evidence, root, _, _ = private_fake_pilot
+    plan, page = gate.prepare_manual_pilot_viewer(evidence, root)
+    (root / "neural-one" / "002-001.mp4").write_bytes(b"MUTATED FAKE TEST")
+    with pytest.raises(ValueError, match="changed"):
+        gate.save_human_observation(evidence, root, plan,
+                                    dict.fromkeys(gate.CAST, "PASS"), gate.PHRASE)
+    assert not list(root.glob(gate.REVIEW_PREFIX + "*.json"))
