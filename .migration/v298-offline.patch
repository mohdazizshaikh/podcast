+def test_changed_existing_review_cannot_claim_publication_approval(private_fake_pilot):
+    evidence, root, _, _ = private_fake_pilot
+    plan, page = gate.prepare_manual_pilot_viewer(evidence, root)
+    record, note = gate.save_human_observation(
+        evidence, root, plan, dict.fromkeys(gate.CAST, "PASS"), gate.PHRASE)
+    data = json.loads(note.read_text(encoding="utf8"))
+    data["publication_approved"] = True
+    note.write_text(json.dumps(data), encoding="utf8")
+    with pytest.raises(ValueError, match="invalid flags"):
+        gate.inspect_latest_observation(evidence, root)
