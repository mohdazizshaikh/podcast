+def test_current_face_sha_mutation_invalidates_old_human_review(private_fake_pilot):
+    evidence, root, _, _ = private_fake_pilot
+    plan, page = gate.prepare_manual_pilot_viewer(evidence, root)
+    rec, path = gate.save_human_observation(
+        evidence, root, plan, dict.fromkeys(gate.CAST, 'PASS'), gate.PHRASE)
+    assert path.is_file()
+    (root / 'neural-one' / '001-001.mp4').write_bytes(b'AFTER REVIEW FAKE ALTERED VIDEO')
+    with pytest.raises(ValueError, match='changed'):
+        gate.inspect_latest_observation(evidence, root)
+    assert path.is_file()  # old human note never deleted or silently overwritten
