+def test_symlinked_review_page_refused(private_fake_pilot):
+    evidence, root, _, _ = private_fake_pilot
+    plan = gate.plan_three_face_review(evidence, root)
+    target = root / "untrusted.html"
+    target.write_text("FAKE TEST ONLY")
+    path = gate._private_page_path(root, plan)
+    try:
+        path.symlink_to(target)
+    except (NotImplementedError, OSError):
+        pytest.skip("Windows may require symlink privileges")
+    with pytest.raises(ValueError, match="Symlinked"):
+        gate.prepare_manual_pilot_viewer(evidence, root)
