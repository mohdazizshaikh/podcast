@@ -0,0 +1,48 @@
+@echo off
+setlocal EnableExtensions DisableDelayedExpansion
+cd /d "%~dp0"
+title Podcast GPT - Private Human Review of Three Real Hindi AI Faces
+if not exist ".venv\Scripts\python.exe" goto :failed
+set "BASE=%~1"
+if not defined BASE set /p "BASE=Existing private signed Hindi BASE folder: "
+set "BASE=%BASE:"=%"
+if not defined BASE goto :failed
+set "OUT=%~2"
+if not defined OUT set "OUT=%BASE%\neural-speech-chunks"
+set "OUT=%OUT:"=%"
+if not exist "%BASE%\original\real-hindi-episode.qc.json" goto :failed
+if not exist "%BASE%\portraits\aarav.png" goto :failed
+if not exist "%BASE%\portraits\meera.png" goto :failed
+if not exist "%BASE%\portraits\kabir.png" goto :failed
+if not exist "%OUT%\precise-speech-chunks.json" goto :failed
+set "MODE=%~3"
+if /I "%MODE%"=="INSPECT" goto :inspect
+if defined MODE goto :failed
+echo.
+echo PRIVATE ORIGINAL HINDI PILOT: no AI inference, no downloads, no uploads.
+echo Requires 1 genuine SHA-bound and independently decoded face MP4 for EACH
+echo Aarav, Meera, Kabir before continuing. This is only HUMAN observation.
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0scripts\preflight_hybrid.ps1" -Phase Source -WorkspacePath "%BASE%" -OutputPath "%OUT%"
+if errorlevel 1 goto :failed
+".venv\Scripts\python.exe" -m scripts.pilot_quality_gate --episode-root "%BASE%\original" --portrait-dir "%BASE%\portraits" --output "%OUT%" --prepare --open-browser
+if errorlevel 1 goto :failed
+echo.
+echo Review all THREE actual saved Hindi speaking-face clips in browser.
+echo Check mouths against original Hindi audio; check cropping, motion and
+echo face identity. Browser checks are NOT publication approval.
+pause
+".venv\Scripts\python.exe" -m scripts.pilot_quality_gate --episode-root "%BASE%\original" --portrait-dir "%BASE%\portraits" --output "%OUT%" --record
+if errorlevel 1 goto :failed
+echo [PASS] A private self-attested human review note was saved.
+echo This does NOT approve full 10-minute lip sync, portrait rights or publishing.
+exit /b 0
+
+:inspect
+echo [READ ONLY] Recheck current originals, three preview videos and note.
+".venv\Scripts\python.exe" -m scripts.pilot_quality_gate --episode-root "%BASE%\original" --portrait-dir "%BASE%\portraits" --output "%OUT%" --inspect
+exit /b %ERRORLEVEL%
+
+:failed
+echo [BLOCKED] Missing signed source, three verified face previews, invalid
+echo answers or stale/unsafe private review. No AI model launched.
+exit /b 1
